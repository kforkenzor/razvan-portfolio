# Absolute origin used for canonical URLs, OG tags and JSON-LD (src/resources/once-ui.config.ts).
# Falls back to http://localhost:3000 when unset, so local dev needs nothing.
# Set this in every deploy environment — preview deploys should point at their own URL.
# TODO(razvan): set this to the real production domain once it exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
